		UInt64 UncompressedSize{ get; };
		Windows.Foundation.Collections.IVectorView<AppxBlockMapBlock> Blocks{ get; };

		Boolean ValidateFileHash(Windows.Storage.Streams.IInputStream fileStream);
	};

	runtimeclass AppxBlockMapFile : [default] IAppxBlockMapFileRuntimeClass
	{

	}

	[exclusiveto(AppxBlockMap)]
	interface IAppxBlockMap
	{
		String HashMethod{ get; };
		Windows.Foundation.Collections.IMapView<String, AppxBlockMapFile> Files{ get; };

		Windows.Storage.Streams.IInputStream GetBlockMapStream();
	};

	runtimeclass AppxBlockMap : [default] IAppxBlockMap
	{

	}

	[contract(Windows.Foundation.UniversalApiContract, 1.0)]
	runtimeclass AppxPackage : [default] IAppxPackageCore, IAppxPackagePayloadFilesProvider, IAppxPackage, IAppxPackage3, IAppxPackage4, IAppxPackage6, IAppxPackage10, IAppxPackageLegacy
	{

	}

	[version(0.63)]
	[exclusiveto(AppxBundle)]
	interface IAppxBundleCore
	{
		String Name{ get; };
		String FamilyName{ get; };
		String FullName{ get; };
		String Publisher{ get; };
		Windows.ApplicationModel.PackageVersion Version{ get; };
		Windows.System.ProcessorArchitecture Architecture{ get; };
		String ResourceId{ get; };

		Windows.Foundation.IAsyncOperation<Windows.Foundation.Collections.IVectorView<AppxPackage> >  GetPackagesAsync();
		Windows.Storage.Streams.IInputStream GetManifestStream();
	};

	runtimeclass AppxBundle : [default] IAppxBundleCore
	{
		
	}

	[exclusiveto(AppxPackageFactory)]
	interface IAppxPackageFactory
	{
		AppxPackage GetAppxPackageFromStream(Windows.Storage.Streams.IRandomAccessStream appxPackageStream);
	};

	[version(0.63)]
	[exclusiveto(AppxPackageFactory)]
	interface IAppxBundleRuntimeClassFactory
	{
		AppxBundle GetAppxBundleFromStream(Windows.Storage.Streams.IRandomAccessStream appxBundleStream);
	};

